#!/bin/sh
# commit-msg hook: reject a message that contains a private term.
# Terms come from $PRIVATE_TERMS_FILE or ~/.config/private-terms.txt.
# If neither file exists, this hook does nothing. It never prints a term.
set -eu

message_file=${1:-}
if [ -z "$message_file" ]; then
  echo "commit-msg hook: message file required" >&2
  exit 1
fi

terms_file=
if [ -n "${PRIVATE_TERMS_FILE:-}" ] && [ -f "$PRIVATE_TERMS_FILE" ]; then
  terms_file=$PRIVATE_TERMS_FILE
elif [ -n "${HOME:-}" ] && [ -f "${HOME}/.config/private-terms.txt" ]; then
  terms_file=${HOME}/.config/private-terms.txt
else
  exit 0
fi

root=$(git rev-parse --show-toplevel)
exec python3 "$root/scripts/privacy-guard.py" --terms-file "$terms_file" --commit-message-file "$message_file"
