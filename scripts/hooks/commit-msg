#!/bin/sh
# commit-msg hook: reject a message that contains a private term.
# Terms come from $PRIVATE_TERMS_FILE, ~/.config/privacy-guard/private-terms.txt,
# or ~/.config/private-terms.txt (home is $HOME, else $USERPROFILE).
# If none exists, this hook does nothing. It never prints a term.
set -eu

message_file=${1:-}
if [ -z "$message_file" ]; then
  echo "commit-msg hook: message file required" >&2
  exit 1
fi

home=${HOME:-${USERPROFILE:-}}
terms_file=
if [ -n "${PRIVATE_TERMS_FILE:-}" ] && [ -f "$PRIVATE_TERMS_FILE" ]; then
  terms_file=$PRIVATE_TERMS_FILE
elif [ -n "$home" ] && [ -f "$home/.config/privacy-guard/private-terms.txt" ]; then
  terms_file=$home/.config/privacy-guard/private-terms.txt
elif [ -n "$home" ] && [ -f "$home/.config/private-terms.txt" ]; then
  terms_file=$home/.config/private-terms.txt
else
  exit 0
fi

root=$(git rev-parse --show-toplevel)
# Git Bash hands this hook POSIX paths ($HOME=/c/Users/... is the normal case)
# and a native python cannot open those. Convert to a Windows path when
# cygpath is available, then pass both paths as environment variables: MSYS
# rewrites argument paths on the way to a native interpreter, environment
# values travel untouched.
to_windows() {
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -w -- "$1" 2>/dev/null || printf '%s\n' "$1"
  else
    printf '%s\n' "$1"
  fi
}
terms_file=$(to_windows "$terms_file")
message_file=$(to_windows "$message_file")
# Prefer a working python3, then python, then the Windows py launcher. The
# Windows Store stub named python3 exists but fails, so test each one.
for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "import sys" >/dev/null 2>&1; then
    PRIVACY_GUARD_TERMS_FILE=$terms_file
    PRIVACY_GUARD_MESSAGE_FILE=$message_file
    export PRIVACY_GUARD_TERMS_FILE PRIVACY_GUARD_MESSAGE_FILE
    exec "$candidate" "$root/scripts/privacy-guard.py"
  fi
done
echo "commit-msg hook: python 3 not found" >&2
exit 1
